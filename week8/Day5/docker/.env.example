# ==============================================================================
# Environment Configuration & Secrets Template (.env.example)
# Week 8 — Day 5 Task 3
# ==============================================================================

# Application Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# FastAPI Serving Gateway
API_PORT=8000
API_HOST=0.0.0.0
API_SECRET_KEY=prod_super_secret_gateway_key_9981

# PostgreSQL Production Database
POSTGRES_USER=re_admin
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=realestate_ml_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://re_admin:replace_with_strong_database_password@localhost:5432/realestate_ml_platform

# Streamlit Intelligence Dashboard
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
API_BASE_URL=http://localhost:8000

# LLM Providers (for LangGraph Assistant)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here

# Voice Integration & Notification Hooks
VAPI_PRIVATE_KEY=your_vapi_private_key
VAPI_ASSISTANT_ID=your_vapi_assistant_id
HOT_LEAD_ALERT_EMAIL=closer-team@netixsol.com
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# MLOps Monitoring Thresholds
MAPE_ALERT_THRESHOLD=15.0
DRIFT_P_VALUE_THRESHOLD=0.05
MAX_LATENCY_SLA_MS=500

# =============================================================================
# City Care Clinics — Multi-Agent AI Healthcare Assistant Configuration
# =============================================================================

# --- 1. LLM Credentials & Models ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=your_gemini_api_key_here

# --- 2. Database & Data Layer ---
DATABASE_URL=sqlite:///week9/Day2/clinic_fhir.db
# PostgreSQL alternative for production:
# DATABASE_URL=postgresql://clinic_admin:CityCareSecure2026!@localhost:5432/clinic_fhir

# --- 3. ChromaDB & Vector Knowledge Base ---
CHROMA_PERSIST_DIRECTORY=week9/Day2/chroma_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- 4. FastMCP & Service Ports ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
DOCTOR_DASHBOARD_PORT=8501
PATIENT_PORTAL_PORT=8502

# --- 5. Medical Safety & Clinical Governance ---
ENFORCE_RED_FLAGS=true
EMERGENCY_RECALL_TARGET=1.00
HITL_MANDATORY_ON_LABS=true
HITL_MANDATORY_ON_RX=true
TRIAGE_LOW_CONFIDENCE_THRESHOLD=0.85

# --- 6. Notifications & WhatsApp Integration ---
WHATSAPP_SIMULATOR=true
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
CLINIC_SENDER_EMAIL=notifications@citycareclinics.pk

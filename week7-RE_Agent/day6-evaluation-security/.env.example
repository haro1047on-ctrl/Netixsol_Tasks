# ===================================================================
# RealEstate Hub — Week 7 Day 6 Production Environment Variables
# ===================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
APP_ENV=production
LOG_LEVEL=INFO
SECRET_KEY=realestate-hub-production-secret-key-day6

# LLM & Embedding Settings (Google Gemini)
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Voice Engine Settings (Vapi & Deepgram)
VAPI_API_KEY=your_vapi_api_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
VAPI_VOICE_ID=Elliot
VAPI_VOICE_PROVIDER=vapi
VAPI_TRANSCRIBER_MODEL=nova-3
VAPI_TRANSCRIBER_LANGUAGE=ur
BACKEND_PUBLIC_URL=https://your-domain.ngrok-free.app

# Database & Storage
DB_BACKEND=sqlite
SQLITE_PATH=../realestate-hub/backend/storage/realestate.db
CHROMA_DIR=../realestate-hub/backend/storage/chroma_db

# Service Level Objectives (SLOs)
SLO_LATENCY_P95_MS=1500.0
SLO_MAX_ERROR_RATE=0.05
SLO_MIN_SUCCESS_RATE=0.90
SLO_MAX_HALLUCINATION_RATE=0.02
